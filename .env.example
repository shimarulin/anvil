# ═══════════════════════════════════════
# Anvil Environment Configuration
# Copy to .env and edit values
# ═══════════════════════════════════════

# ─── Main model (agents, chat, planning) ───
AI_ENDPOINT=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4
AI_MAX_TOKENS=8192

# ─── Fast model (inline completions, small tasks) ───
# Falls back to main endpoint/key if not set
AI_FAST_MODEL=anthropic/claude-haiku
AI_FAST_MAX_TOKENS=2048

# ─── Planner model (architect mode) ───
AI_PLANNER_MODEL=anthropic/claude-sonnet-4
AI_PLANNER_MAX_TOKENS=16384

# ─── Local model (Ollama) ───
AI_LOCAL_ENDPOINT=http://localhost:11434/v1
AI_LOCAL_API_KEY=ollama
AI_LOCAL_MODEL=qwen2.5-coder:14b
AI_LOCAL_MAX_TOKENS=4096

# ─── Anvil settings ───
ANVIL_LOG_LEVEL=info
ANVIL_COLORSCHEME=catppuccin

# ─── MCP (optional) ───
# BRAVE_API_KEY=BSAxxxxxxxxxxxxx
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
